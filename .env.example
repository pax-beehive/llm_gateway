OPENAI_API_KEY=

DEEPSEEK_API_KEY=

ANTHROPIC_API_KEY=

GEMINI_API_KEY=

# BFF (operations console). All have dev defaults; set a token to empty to
# disable that upstream (its /api proxy answers 503 upstream_not_configured).
BFF_ADDR=
BFF_GATEWAY_URL=
BFF_GATEWAY_API_KEY=
BFF_CONTROL_PLANE_URL=
BFF_CONTROL_PLANE_TOKEN=
BFF_METERING_URL=
BFF_METERING_TOKEN=
BFF_WEB_DIST=

# Real WorkOS AuthKit mode. Leave all four unset for local BFF_DEV_AUTH mode;
# production must provide the complete set through Secret Manager/runtime env.
# BFF_PUBLIC_URL=https://llm-console.paxtech.net
# BFF_WORKOS_API_KEY=sk_...
# BFF_WORKOS_CLIENT_ID=client_...
# BFF_WORKOS_COOKIE_PASSWORD=<at-least-32-random-characters>
# BFF_WORKOS_OPERATOR_ORGANIZATION_ID=org_...
# BFF_SESSION_COOKIE_SECURE=true
